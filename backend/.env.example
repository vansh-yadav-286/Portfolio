# No database. Auth is Google/GitHub OAuth only, with a signed, stateless
# session cookie - this secret is what makes that cookie trustworthy. Treat it
# like a password; generate one with `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=change_this_to_a_long_random_value
SESSION_MAX_AGE_MINUTES=120

FRONTEND_URL=http://localhost:5500

# The only account that gets admin access. Whichever Google/GitHub account
# authenticates with this exact (verified) email is granted the admin role -
# there is no separate password or user table.
ADMIN_EMAIL=admin@example.com

# This backend's own public URL. Used to build the OAuth callback URLs
# registered with Google/GitHub below (must exactly match what you register
# there). Locally this is usually http://localhost:8000; in production it's
# your Render service's URL, e.g. https://portfolio-api-xxxx.onrender.com
BACKEND_URL=http://localhost:8000

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth client ID -> Web application). Authorized redirect URI:
#   {BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (GitHub -> Settings -> Developer settings -> OAuth Apps ->
# New OAuth App). Authorization callback URL:
#   {BACKEND_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Contact form -> outbound email. No database, so a submission is forwarded by
# SMTP instead of stored. Left blank, POST /api/contact returns 503. Example
# values for Gmail (use an app password, not your real password) or any SMTP
# provider (SendGrid, Mailgun, your own mail server, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
