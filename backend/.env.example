# Locally, point this at your own Postgres (or a direct Supabase connection
# on port 5432). In production, use Supabase's *pooled* connection string
# (port 6543, via Supavisor/PgBouncer) instead of the direct one on 5432.
# Vercel serverless functions are short-lived and can spin up many concurrent
# instances, each opening its own DB connection; Supabase's direct Postgres
# port has a low connection cap that this pattern exhausts quickly, while the
# pooled port is designed for exactly this (many short-lived serverless
# connections). Get it from Supabase: Project Settings -> Database ->
# Connection string -> "Transaction" pooling mode.
DATABASE_URL=postgresql+psycopg://postgres.xxxxxxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
SECRET_KEY=change_this_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5500
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# This backend's own public URL. Used to build the OAuth callback URLs
# registered with Google/GitHub below (must exactly match what you register
# there). Locally this is usually http://localhost:8000; in production it's
# your Vercel deployment URL for this backend project, e.g.
# https://portfolio-api.vercel.app
BACKEND_URL=http://localhost:8000

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth client ID -> Web application). Authorized redirect URI:
#   {BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (GitHub -> Settings -> Developer settings -> OAuth Apps ->
# New OAuth App). Authorization callback URL:
#   {BACKEND_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
